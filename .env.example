# ─────────────────────────────────────────────────────────────
# NDD.Studio — Environment Variables
# Add these to Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Contact Form (Gmail SMTP) ─────────────────────────────────
# Your Gmail address
GMAIL_USER=bhikhapurmustafa@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# How to get it:
#   1. Go to https://myaccount.google.com/security
#   2. Turn on 2-Step Verification (if not already)
#   3. Search "App passwords" → Create one (Mail + Other)
#   4. Copy the 16-character password and paste below
GMAIL_PASS=your_16_char_app_password_here

# ── Chatbot ───────────────────────────────────────────────────
# No API key needed — chatbot runs entirely on your server.
# It uses a smart rule-based system, zero external calls, zero cost.
